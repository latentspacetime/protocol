#!/bin/zsh
# ghostty-theme — pick a Ghostty theme with live preview.
#
# Usage:
#   ghostty-theme            set the DEFAULT theme: fzf picker, arrow keys
#                            preview live in this terminal, Enter persists to
#                            the config (all new tabs/windows open with it),
#                            Esc keeps the current default.
#   ghostty-theme here       theme THIS terminal only: same picker, but Enter
#                            applies without persisting — the next tab/window
#                            still opens with the default. An nvim started in
#                            this terminal inherits the local theme.
#   ghostty-theme apply X    non-interactive `here`: apply theme X to this
#                            terminal, no persistence
#
# The default persists as the `theme =` line in ~/.config/ghostty/config.
# Other open Ghostty windows pick a new default up on config reload
# (cmd+shift+,); new windows read it on their own. nvim runs with
# termguicolors off and transparent backgrounds, so retheming a terminal
# rethemes the nvim inside it live too.
#
# Live preview covers palette, background, foreground, and cursor color;
# selection colors have no portable OSC and land on config reload instead.
#
# Docs: Cortex/Runbooks/ghostty-theme-workflow.md

set -u
SELF="${0:A}"
CONFIG="$HOME/.config/ghostty/config"
USER_THEMES="$HOME/.config/ghostty/themes"
RESOURCE_THEMES="/Applications/Ghostty.app/Contents/Resources/ghostty/themes"

die() { print -r -- "ghostty-theme: $1" >&2; exit 1 }

theme_file() {
    local name="$1"
    [[ -f "$USER_THEMES/$name" ]] && { print -r -- "$USER_THEMES/$name"; return 0 }
    [[ -f "$RESOURCE_THEMES/$name" ]] && { print -r -- "$RESOURCE_THEMES/$name"; return 0 }
    return 1
}

# Emits the theme's OSC sequences straight to the terminal, plus palette
# swatches on stdout (fzf shows stdout in the preview pane).
apply() {
    local file
    file=$(theme_file "$1") || die "unknown theme: $1"
    local tty_out="${NVIM_HOST_TTY:-/dev/tty}"
    # -w passes even when the device can't open (e.g. no controlling tty in
    # scripts/tests), so probe with a real write.
    print -n '' > $tty_out 2>/dev/null || tty_out=/dev/null
    local line key val
    while IFS= read -r line; do
        key="${line%%=*}"; key="${key// /}"
        val="${line#*=}"; val="${val# }"
        case "$key" in
            palette)      printf '\033]4;%s;%s\033\\' "${val%%=*}" "${val#*=}" > $tty_out ;;
            background)   printf '\033]11;%s\033\\' "$val" > $tty_out ;;
            foreground)   printf '\033]10;%s\033\\' "$val" > $tty_out ;;
            cursor-color) printf '\033]12;%s\033\\' "$val" > $tty_out ;;
        esac
    done < "$file"
    local i
    for i in {0..15}; do
        printf '\033[48;5;%dm   \033[0m' "$i"
        [[ $i -eq 7 ]] && print
    done
    print
    print -r -- "$1"
}

list_themes() {
    { command ls "$USER_THEMES" 2>/dev/null
      ghostty +list-themes --plain 2>/dev/null | sed 's/ (resources)$//'
    } | sort -u
}

current_theme() { sed -n 's/^theme = //p' "$CONFIG" | tail -1 }

# Ghostty creates new tabs/windows from its startup-time in-memory config, so
# a persisted change is invisible until the app reloads. The macOS build
# reloads on SIGUSR2 (its handler logs "reloading configuration in response
# to SIGUSR2"). pgrep/pkill cannot see the GUI app process (macOS hides its
# argv), so locate it via ps and match the app-bundle binary path.
reload_ghostty() {
    local pids
    pids=$(ps ax -o pid=,comm= | awk '/Ghostty\.app\/Contents\/MacOS\/ghostty$/ {print $1}')
    [[ -n "$pids" ]] || return 1
    kill -USR2 ${=pids} 2>/dev/null
}

persist() {
    local name="$1"
    if grep -q '^theme = ' "$CONFIG"; then
        sed -i '' "s|^theme = .*|theme = $name|" "$CONFIG"
    else
        print -r -- "theme = $name" >> "$CONFIG"
    fi
}

# mode "default": Enter persists to the config. mode "here": Enter applies to
# this terminal only. Esc always falls back to the configured default —
# a previous `here` theme isn't tracked, so it can't be restored.
pick() {
    local mode="$1"
    [[ -f "$CONFIG" ]] || die "missing config: $CONFIG"
    local header
    if [[ "$mode" == default ]]; then
        header="Enter: set default for new tabs/windows | Esc: keep $(current_theme)"
    else
        header="Enter: theme THIS terminal only | Esc: back to default"
    fi
    local choice
    choice=$(list_themes | fzf --prompt="Ghostty theme ($mode)> " \
        --preview="${(q)SELF} apply {}" --preview-window=down,4 \
        --header="$header")
    if [[ -n "${choice:-}" ]]; then
        apply "$choice" > /dev/null
        if [[ "$mode" == default ]]; then
            persist "$choice"
            if reload_ghostty; then
                print -r -- "Default theme: $choice — Ghostty reloaded, new tabs/windows will use it"
            else
                print -r -- "Default theme: $choice — reload Ghostty (cmd+shift+,) so new tabs pick it up"
            fi
        else
            print -r -- "This terminal: $choice (default stays $(current_theme))"
        fi
    else
        local kept
        kept=$(current_theme)
        [[ -n "$kept" ]] && apply "$kept" > /dev/null
        print -r -- "Kept default: ${kept:-(no theme line in config)}"
    fi
}

case "${1:-}" in
    "")    pick default ;;
    here)  pick here ;;
    apply)
        [[ $# -eq 2 ]] || die "usage: ghostty-theme apply <name>"
        apply "$2"
        ;;
    *)
        die "usage: ghostty-theme [here | apply <name>]"
        ;;
esac
